    {
      "id": "widget_session_professor_engelsk-sprog-og-kultur_cat1_activity",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_engelsk-sprog-og-kultur_2",
      "type": "text",
      "title": "Arbejd aktivt",
      "geometry": {
        "x": 760,
        "y": 85,
        "width": 420,
        "height": 315,
        "rotation": 0,
        "z": 2
      },
      "content": {
        "text": "AKTIV OPGAVE\n\nSkriv én kort engelsk sætning med hvert ord. Byt med en makker, der oversætter og kontrollerer, om ordet bruges i den rigtige betydning.\n\nKRAV TIL SVARET\n• Alle fem faglige koblinger skal med.\n• Brug præcise navne, tal, steder eller begreber.\n• En anden gruppe skal kunne kontrollere jeres forklaring.",
        "fontSize": 16,
        "align": "left"
      },
