      "legacy": null
    },
    {
      "id": "widget_session_professor_verdenskrigenes-historie_cat1_check",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_verdenskrigenes-historie_2",
      "type": "text",
      "title": "Kontrol og huskesystem",
      "geometry": {
        "x": 760,
        "y": 420,
        "width": 420,
        "height": 365,
        "rotation": 0,
        "z": 3
      },
      "content": {
        "text": "PROFESSORENS KONTROL\n\nSvar uden valgmuligheder:\n• Hvad kaldtes de tyske ubåde under Første Verdenskrig?\n• Hvilket britisk passagerskib blev sænket af en tysk ubåd i 1915?\n• I hvilket år gik USA ind i Første Verdenskrig?\n• Hvilken revolution førte til, at bolsjevikkerne tog magten i Rusland i november 1917 efter den gregorianske kalender?\n• Hvilken fredsaftale trak Rusland ud af krigen i marts 1918?\n\nHUSKESYSTEM\nU-både → Lusitania 1915 → USA 1917 → Oktoberrevolutionen 1917 → Brest-Litovsk 1918.",
        "fontSize": 14,
        "align": "left"
      },
      "settings": {
        "locked": false,
        "hidden": false,
        "minimized": false,
        "maximized": false,
