    {
      "id": "widget_session_professor_matematik_cat2_facts",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_matematik_3",
      "type": "text",
      "title": "Kernestof · Brøker og procent",
      "geometry": {
        "x": 20,
