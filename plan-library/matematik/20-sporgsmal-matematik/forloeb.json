    },
    {
      "id": "widget_session_professor_matematik_cat1_activity",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_matematik_2",
      "type": "text",
      "title": "Arbejd aktivt",
      "geometry": {
        "x": 760,
        "y": 85,
        "width": 420,
        "height": 315,
        "rotation": 0,
        "z": 2
      },
      "content": {
        "text": "AKTIV OPGAVE\n\nLøs hvert udtryk på to måder, når det er muligt. Sæt ring om det trin, hvor regnehierarkiet er afgørende, og lav et overslag før det præcise svar.\n\nKRAV TIL SVARET\n• Alle fem faglige koblinger skal med.\n• Brug præcise navne, tal, steder eller begreber.\n• En anden gruppe skal kunne kontrollere jeres forklaring.",
        "fontSize": 16,
        "align": "left"
      },
      "settings": {
        "locked": false,
        "hidden": false,
        "minimized": false,
        "maximized": false,
        "restoreGeometry": null
      },
      "relations": {
