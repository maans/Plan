    },
    {
      "id": "widget_session_professor_matematik_cat1_check",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_matematik_2",
      "type": "text",
      "title": "Kontrol og huskesystem",
      "geometry": {
        "x": 760,
        "y": 420,
        "width": 420,
        "height": 365,
        "rotation": 0,
        "z": 3
      },
      "content": {
        "text": "PROFESSORENS KONTROL\n\nSvar uden valgmuligheder:\n• Hvad er 7 · (5 + 3)?\n• Hvad er 250 ÷ 5 + 17?\n• Hvad er 3 · 24 - 16?\n• Hvad er 1.000 - 468?\n• Hvad er 32 · 15?\n\nHUSKESYSTEM\nParentes før gange og division, før plus og minus. Brug overslag til at opdage taste- og hovedregningsfejl.",
        "fontSize": 14,
        "align": "left"
      },
