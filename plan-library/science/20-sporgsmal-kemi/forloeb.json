      "legacy": null
    },
    {
      "id": "widget_session_professor_kemiens-grundstoffer_cat1_activity",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_kemiens-grundstoffer_2",
      "type": "text",
      "title": "Arbejd aktivt",
      "geometry": {
        "x": 760,
        "y": 85,
        "width": 420,
        "height": 315,
        "rotation": 0,
        "z": 2
      },
      "content": {
        "text": "AKTIV OPGAVE\n\nBrug et periodesystem som opslag – derefter lukkes det. Skriv fem kort med symbol på den ene side og dansk navn på den anden, og træn begge retninger.\n\nKRAV TIL SVARET\n• Alle fem faglige koblinger skal med.\n• Brug præcise navne, tal, steder eller begreber.\n• En anden gruppe skal kunne kontrollere jeres forklaring.",
        "fontSize": 16,
        "align": "left"
      },
      "settings": {
