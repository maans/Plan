    {
      "id": "widget_session_professor_film-fra-1980erne_cat1_facts",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_film-fra-1980erne_2",
      "type": "text",
      "title": "Kernestof · Instruktører og film",
      "geometry": {
        "x": 20,
        "y": 85,
        "width": 720,
        "height": 700,
        "rotation": 0,
        "z": 1
      },
      "content": {
        "text": "PROFESSORENS KERNESTOF · INSTRUKTØRER OG FILM\n\n1. Hvem instruerede “The Elephant Man” fra 1980?\n   FACIT: David Lynch\n\n2. Hvem instruerede “The Last Emperor” fra 1987?\n   FACIT: Bernardo Bertolucci\n\n3. Hvem instruerede “Cinema Paradiso” fra 1988?\n   FACIT: Giuseppe Tornatore\n\n4. Hvem instruerede animationsfilmen “My Neighbor Totoro” fra 1988?\n   FACIT: Hayao Miyazaki\n\n5. Hvem instruerede “Ran” fra 1985?\n   FACIT: Akira Kurosawa\n\nLæs først med facit. Luk derefter denne tavle mentalt ved at dække svarlinjerne og genkalde dem i rækkefølge.",
        "fontSize": 17,
        "align": "left"
      },
      "settings": {
        "locked": false,
        "hidden": false,
        "minimized": false,
        "maximized": false,
        "restoreGeometry": null
      },
      "relations": {
        "layoutRole": "core"
      },
      "createdAt": "2026-07-06T00:55:00.000Z",
      "updatedAt": "2026-07-06T00:55:00.000Z",
      "legacy": null
    },
    {
      "id": "widget_session_professor_film-fra-1980erne_cat1_activity",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_film-fra-1980erne_2",
      "type": "text",
      "title": "Arbejd aktivt",
      "geometry": {
        "x": 760,
        "y": 85,
        "width": 420,
        "height": 315,
        "rotation": 0,
        "z": 2
      },
      "content": {
        "text": "AKTIV OPGAVE\n\nLav en instruktørfestival: fem grupper får hver en film og skal præsentere instruktør, år og én huskedetalje uden at afsløre de andre kort.\n\nKRAV TIL SVARET\n• Alle fem faglige koblinger skal med.\n• Brug præcise navne, tal, steder eller begreber.\n• En anden gruppe skal kunne kontrollere jeres forklaring.",
        "fontSize": 16,
        "align": "left"
      },
      "settings": {
