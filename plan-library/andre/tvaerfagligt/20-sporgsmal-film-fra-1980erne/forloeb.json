    {
      "id": "widget_session_professor_film-fra-1980erne_rehearsal_header",
      "schemaVersion": 3,
      "widgetVersion": 1,
      "boardId": "board_session_professor_film-fra-1980erne_6",
      "type": "text",
      "title": "Sådan gør I",
      "geometry": {
        "x": 20,
        "y": 85,
        "width": 1160,
        "height": 180,
        "rotation": 0,
        "z": 1
      },
      "content": {
        "text": "PROFESSORENS PRØVEVÆRKSTED\n\nArbejd i fire ekspertgrupper – én kategori pr. gruppe. Hver gruppe har 8 minutter til at kunne forklare sine fem svar uden at læse op. Derefter dannes nye grupper med én ekspert fra hver kategori. Til sidst vælges de steder, klassen stadig er usikker på, til en kort fælles præcisering.\n\nRegel: Et svar tæller først som lært, når eleven kan forklare, hvorfor det er rigtigt.",
        "fontSize": 16,
        "align": "left"
      },
      "settings": {
        "locked": false,
        "hidden": false,
        "minimized": false,
        "maximized": false,
        "restoreGeometry": null
      },
      "relations": {
        "layoutRole": "rehearsal-guide"
      },
      "createdAt": "2026-07-06T00:55:00.000Z",
      "updatedAt": "2026-07-06T00:55:00.000Z",
      "legacy": null
    },
